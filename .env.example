# Paste your Google Gemini API key after the = sign (no quotes, no spaces), then save.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# How long a chat is remembered after its last message, in minutes (default 30).
# After a longer pause the assistant forgets the earlier messages and starts fresh.
MEMORY_MINUTES=30
# How many recent messages are remembered within that time (default 6).
MEMORY_MESSAGES=6

# How hard the model thinks before replying: minimal, low, medium (default) or high.
REASONING_LEVEL=medium
